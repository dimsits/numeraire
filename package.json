{
  "name": "numeraire",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance ledger with deterministic categorization and a capability-scoped AI assistant",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "dev:api": "tsx watch src/main-api.ts",
    "dev:worker": "tsx watch src/main-worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:api": "vitest run --project api",
    "coverage": "vitest run --coverage --passWithNoTests",
    "coverage:check": "vitest run --coverage --passWithNoTests",
    "boundaries": "depcruise src scripts --config .dependency-cruiser.js && tsx scripts/check-invariants.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run boundaries",
    "verify:full": "npm run verify && npm run test:integration && npm run test:api && npm run coverage:check",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "uuid": "14.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsc-alias": "1.9.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
