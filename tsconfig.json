{
  "compilerOptions": {
    /* Node 22 LTS target — ARCHITECTURE.md §4. */
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    /* Path aliases — DEV_PIPELINE.md task 0.1.
       Rewritten to relative specifiers at build time by tsc-alias. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    },

    /* Strictness. `strict: true` plus additional checks only — nothing here
       weakens the defaults, and nothing may be removed to make a build pass. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    /* ESM discipline: emitted JS must be valid Node ESM. */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Claude Code hook scripts are .mjs with JSDoc types; typecheck covers them. */
    "allowJs": true,
    "checkJs": true,

    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "*.ts",
    "eslint.config.js",
    ".dependency-cruiser.js"
  ],
  "exclude": ["node_modules", "dist", "coverage", "tests/fixtures"]
}
