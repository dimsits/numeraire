# Numeraire — environment contract (ARCHITECTURE.MD §16)
#
#   cp .env.example .env
#
# Every variable below is validated by src/config/env.ts at boot. A missing or
# malformed value aborts startup with every problem listed at once; it never
# surfaces as an `undefined` three hours into a job.
#
# Commented-out lines are optional and show the schema default.
# This file is committed. `.env` is not. Never put a real secret here.

# ── Process ───────────────────────────────────────────────────────────────
# NODE_ENV=development             # development | test | production
# PORT=3000
# LOG_LEVEL=info                   # trace | debug | info | warn | error

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Host defaults match docker-compose.yml as seen from the host machine.
# From inside a Compose service, the host is `postgres`, not `localhost`.
DATABASE_URL=postgres://postgres:numeraire_dev@localhost:5432/numeraire
# DATABASE_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_this_with_a_locally_generated_32_char_minimum_secret
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# ── AI ────────────────────────────────────────────────────────────────────
# `mock` is the default for local development: deterministic, free, and it
# needs no API key, so a fresh clone runs without an account anywhere.
# Switch to `anthropic` or `openai` only when exercising real model calls —
# the matching API key then becomes required and startup enforces it.
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...     # required when AI_PROVIDER=anthropic
# OPENAI_API_KEY=sk-...            # required when AI_PROVIDER=openai
# AI_CATEGORIZATION_MODEL=claude-haiku-4-5-20251001
# AI_ASSISTANT_MODEL=claude-sonnet-4-6
# AI_DAILY_TOKEN_BUDGET=200000
# AI_CONFIDENCE_THRESHOLD=0.85     # 0..1
# AI_MAX_TOOL_ROUNDTRIPS=5

# ── Import & workers ──────────────────────────────────────────────────────
# IMPORT_MAX_BYTES=10485760        # 10 MiB
# WORKER_CONCURRENCY=2

# ── Compose only ──────────────────────────────────────────────────────────
# Consumed by docker-compose.yml, not by src/config/env.ts.
# POSTGRES_PASSWORD=numeraire_dev
