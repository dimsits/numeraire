{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-migrations.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/typecheck-on-edit.mjs",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node scripts/hooks/invariants-on-domain-edit.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/stop-dirty-tree.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
